# NVIDIA NIM (OpenAI-compatible) configuration
# Copy to .env and fill in your own key. .env is git-ignored.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Primary model used by Agent Mode (must support tool/function calling)
NVIDIA_MODEL=openai/gpt-oss-20b
# Optional comma-separated fallbacks tried on timeout / rate limit
NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-super-120b-a12b
